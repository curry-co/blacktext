<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- iCloud sync for signed Mac builds. scripts/release.sh uses this with a provisioning profile that grants it. -->
<plist version="1.0">
<dict>
    <key>com.apple.application-identifier</key>
    <string>AGX237Q865.co.curry.blacktext</string>
    <key>com.apple.developer.team-identifier</key>
    <string>AGX237Q865</string>
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.co.curry.blacktext</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <key>com.apple.developer.icloud-container-environment</key>
    <string>Production</string>
    <key>com.apple.developer.aps-environment</key>
    <string>production</string>
</dict>
</plist>
